# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file. Gateway mode requires
# X-ITGlue-API-Key (or X-API-Key) or X-ITGlue-JWT on each request.
ITGLUE_API_KEY=
ITGLUE_JWT=
# Region is not a credential. Gateway compose does not interpolate it;
# send X-ITGlue-Region per request instead. Default when unset is us.
ITGLUE_REGION=us
# ITGLUE_BASE_URL=

# Transport: stdio (default when run via npx/node) or http. The container
# image sets http.
MCP_TRANSPORT=stdio

# Bind address. With a real CONDUIT_S2S_SECRET, an unset MCP_HTTP_HOST stays
# 0.0.0.0 so container deploys keep the historical bind. The image and Compose
# set 0.0.0.0 inside the container and publish the host port on 127.0.0.1.
# MCP_ALLOW_INSECURE_DEV=1 ignores this and binds 127.0.0.1 only; a
# non-loopback value refuses to start.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, your-s2s-secret, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST refuses to start.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-ITGlue-API-Key or X-ITGlue-JWT; no env fallback). The Compose service
# sets gateway. The container image defaults to env. Stdio ignores this and
# reads ITGLUE_* from the environment.
# AUTH_MODE=env

LOG_LEVEL=info
